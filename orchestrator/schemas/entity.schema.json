{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Base Entity",
  "type": "object",
  "required": [
    "id",
    "name",
    "status",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "DRAFT",
        "REVIEW",
        "CANON",
        "DEPRECATED"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  }
}