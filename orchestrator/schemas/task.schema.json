{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Orchestrator Task",
  "type": "object",
  "required": [
    "id",
    "title",
    "status",
    "owner",
    "acceptance_criteria"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "enum": [
        "BACKLOG",
        "ACTIVE",
        "REVIEW",
        "DONE",
        "BLOCKED"
      ]
    },
    "owner": {
      "type": "string"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "out_of_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}